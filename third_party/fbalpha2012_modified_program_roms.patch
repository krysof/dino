diff --git a/src/cpu/m68000_intf.cpp b/src/cpu/m68000_intf.cpp
index e9d6294..a1cf45b 100644
--- a/src/cpu/m68000_intf.cpp
+++ b/src/cpu/m68000_intf.cpp
@@ -477,6 +477,47 @@ static INT32 SekSetup(struct A68KContext* psr)
 // Callbacks for Musashi
 
 #ifdef EMU_M68K
+static INT32 (*DinoNativeInstructionCallback)(UINT32 pc) = NULL;
+static INT32 DinoNativeInstructionHandled = 0;
+
+extern "C" void DinoSetNativeInstructionCallback(INT32 (*callback)(UINT32 pc))
+{
+	DinoNativeInstructionCallback = callback;
+}
+
+extern "C" INT32 DinoConsumeNativeInstructionHandled()
+{
+	const INT32 handled = DinoNativeInstructionHandled;
+	DinoNativeInstructionHandled = 0;
+	return handled;
+}
+
+extern "C" UINT32 DinoGetM68KRegister(INT32 reg)
+{
+	return m68k_get_reg(NULL, (m68k_register_t)reg);
+}
+
+extern "C" void DinoSetM68KRegister(INT32 reg, UINT32 value)
+{
+	m68k_set_reg((m68k_register_t)reg, value);
+}
+
+extern "C" UINT32 DinoReadM68KByte(UINT32 address) { return SekReadByte(address); }
+extern "C" UINT32 DinoReadM68KWord(UINT32 address) { return SekReadWord(address); }
+extern "C" UINT32 DinoReadM68KLong(UINT32 address) { return SekReadLong(address); }
+extern "C" void DinoWriteM68KByte(UINT32 address, UINT32 value) { SekWriteByte(address, (UINT8)value); }
+extern "C" void DinoWriteM68KWord(UINT32 address, UINT32 value) { SekWriteWord(address, (UINT16)value); }
+extern "C" void DinoWriteM68KLong(UINT32 address, UINT32 value) { SekWriteLong(address, value); }
+
+static void DinoM68KInstructionHook()
+{
+	DinoNativeInstructionHandled = 0;
+	if (DinoNativeInstructionCallback) {
+		DinoNativeInstructionHandled = DinoNativeInstructionCallback(
+			m68k_get_reg(NULL, M68K_REG_PPC));
+	}
+}
+
 extern "C" INT32 M68KIRQAcknowledge(INT32 nIRQ)
 {
 	if (nSekIRQPending[nSekActive] & SEK_IRQSTATUS_AUTO) {
@@ -567,6 +608,7 @@ static INT32 SekInitCPUM68K(INT32 nCount, INT32 nCPUType)
 		return 1;
 	}
 	memset(SekM68KContext[nCount], 0, nSekM68KContextSize[nCount]);
+	m68k_set_instr_hook_callback(DinoM68KInstructionHook);
 	m68k_get_context(SekM68KContext[nCount]);
 
 	return 0;
